#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

required_files=(
  README.md
  project.md
  environment.md
  team.md
  scope.md
  sprint.md
  tasks.md
  backlog.md
  live.md
  current-status.md
  resume.md
  handoff.md
  human-test.md
  action-log.md
  discussion-log.md
  decision-log.md
  signoff-log.md
  verification-log.md
  risk-register.md
  approval-gates.md
  brief.md
  PANEL-GATE.md
)

mkdir -p "$RT_DIR/audit" "$RT_DIR/roles"

missing=0
for file in "${required_files[@]}"; do
  if [[ ! -f "$RT_DIR/$file" ]]; then
    echo "Missing RoundTable file: $RT_DIR/$file" >&2
    missing=1
  fi
done

for helper in rt-log rt-panel; do
  if [[ ! -x "$RT_DIR/bin/$helper" ]]; then
    echo "Missing/not-executable helper: $RT_DIR/bin/$helper" >&2
    missing=1
  fi
done

if [[ "$missing" -ne 0 ]]; then
  exit 1
fi

# Non-fatal: the brief is the intake every gate derives from. Warn if it's still a template
# (unfilled placeholders) — team formation and scope-lock should not proceed on a blank brief.
if grep -qE '^\s*<[A-Za-z].*>\s*$|TBD' "$RT_DIR/brief.md" 2>/dev/null; then
  echo "WARNING: brief.md still has unfilled placeholders. Fill it before forming the team or locking scope." >&2
fi

# Panel reviewers present? (advisory — the gate itself enforces quorum at run time)
have=""; for cli in claude codex gemini grok; do command -v "$cli" >/dev/null 2>&1 && have="$have $cli"; done
echo "Panel reviewers available:${have:- none — install the CLIs or the panel gate cannot convene}"

bash "$RT_DIR/bin/rt-log" "AI Operator" "Preflight passed. RoundTable folder, logs, audit, panel gate, and helpers are available."
echo "RoundTable preflight passed: $RT_DIR"
